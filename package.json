{
  "name": "health-hub",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:repair-admin": "tsx scripts/repair-admin-auth.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@better-fetch/fetch": "^1.3.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "~1.6.34",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.561.0",
    "next": "^16.4.6",
    "nuqs": "^2.10.3",
    "pg": "^8.23.1",
    "postcss": "^8.5.33",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-to-print": "^3.3.0",
    "recharts": "^3.11.0",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "ws": "^8.23.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{js,jsx,ts,tsx,md,json}": "prettier --write"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.1.3"
