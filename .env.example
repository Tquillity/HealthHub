# Copy to .env and fill in values. Never commit .env.

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better-Auth (required)
BETTER_AUTH_SECRET=""          # Generate: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# Client-side auth (optional — only if browser must call auth API on a different origin)
# src/lib/auth-client.ts uses NEXT_PUBLIC_BETTER_AUTH_URL when window is defined
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Journal field encryption (strongly recommended in production)
# Falls back to BETTER_AUTH_SECRET if unset — not ideal for production
ENCRYPTION_KEY=""

# OAuth providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Recipe image upload (optional — Vercel Blob)
BLOB_READ_WRITE_TOKEN=""
USE_LOCAL_STORAGE="true"       # Use local/public/uploads when no blob token

# Database seed (optional — development only)
ADMIN_EMAIL="admin@healthhub.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin User"
