# Copy to .env and fill in values. Never commit .env.
# Every variable the app, Prisma config and scripts read is listed here; README.md has a summary table.
# Variables starting with NEXT_PUBLIC_ are inlined into the browser bundle at build time, so set them
# before `pnpm build` (and never put a secret in one).

# ─── Required ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon in production). Read by the app (src/lib/db.ts),
# the Prisma CLI (prisma.config.ts) and the scripts in scripts/.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs sessions and auth cookies. At least 32 random characters: openssl rand -base64 32
# Rotating it signs everyone out. While ENCRYPTION_KEY is empty it is ALSO the journal encryption
# secret, so set ENCRYPTION_KEY (see below) before you ever rotate this on a deployment with data.
BETTER_AUTH_SECRET=""

# Public origin of the app, no trailing slash. Better-Auth base URL, the proxy's session lookup
# and Stripe return URLs use it. Production must use https:// (the server warns at startup if a
# non-localhost host uses http://).
BETTER_AUTH_URL="http://localhost:3000"

# Same origin as BETTER_AUTH_URL. Used for canonical / Open Graph / sitemap URLs
# (src/lib/site-metadata.ts) and by the auth client during server rendering; in the browser the
# auth client uses the page's own origin. Inlined at build time.
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# ─── Strongly recommended in production ────────────────────────────────────────────────────

# Journal field encryption secret (AES-256-GCM, see src/lib/encryption.ts). When empty, the key is
# derived from BETTER_AUTH_SECRET instead, and a production server logs a warning at startup.
#
# EXISTING deployment (journal entries already saved): set this to the CURRENT value of
#   BETTER_AUTH_SECRET, copied exactly. Entries stay readable, and BETTER_AUTH_SECRET can then be
#   rotated on its own later.
#   Do NOT generate a new key here. Entries encrypted with the old key would become unreadable:
#   decrypt() cannot recover them and shows the raw ciphertext instead, and saving such an entry
#   overwrites the original for good.
# FRESH deployment (no journal entries yet): a new random key is fine: openssl rand -base64 32
# Once journal entries exist, never change this value (there is no re-encryption tool).
ENCRYPTION_KEY=""

# ─── Optional features ─────────────────────────────────────────────────────────────────────

# Social sign-in. Each provider is enabled only when both its ID and secret are set
# (src/lib/social-providers.ts). X uses Better-Auth's `twitter` provider; see PWA_SETUP.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Recipe and routine image uploads go to Vercel Blob when this token is set
# (src/actions/image-upload.ts); account deletion also removes the user's uploaded images.
# Without it, uploads fail in production.
BLOB_READ_WRITE_TOKEN=""
# Development only: "true" saves uploads to public/uploads when there is no Blob token.
# Ignored when NODE_ENV=production.
USE_LOCAL_STORAGE="true"

# Stripe (optional — gated premium; see Docs/Stripe.md). Billing stays off unless the secret key and
# webhook secret are both set; checkout also needs the Pro price ID.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_ID_PRO=""

# Google AdSense (optional — blocked until legal review; see Docs/AdSense.md). Inlined at build time.
# NEXT_PUBLIC_ADSENSE_CLIENT=""
# NEXT_PUBLIC_ADSENSE_ENABLED=false
# Ad slot IDs; default to "recipes-footer" and "learn-list" when unset.
# NEXT_PUBLIC_ADSENSE_SLOT_RECIPES=""
# NEXT_PUBLIC_ADSENSE_SLOT_LEARN=""

# Legal gate — set true only after counsel approves Privacy/Terms copy (hides the draft banner).
# LEGAL_REVIEW_APPROVED=false

# ─── Database seed and admin repair (scripts only, not read by the running app) ─────────────

ADMIN_EMAIL="admin@healthhub.com"
# Leave empty or omit to use default Admin123! on seed/repair (localhost DB only). If set, this is your sign-in password.
ADMIN_PASSWORD=""
ADMIN_NAME="Admin User"
# Seed/repair refuse non-local DATABASE_URLs unless ALLOW_PROD_SEED=1 and a non-default ADMIN_PASSWORD are set.
# ALLOW_PROD_SEED=""

# ─── Playwright E2E (optional — see Docs/E2E.md) ───────────────────────────────────────────

# Set both to your disposable test user's credentials. Leave empty to skip auth E2E locally.
PLAYWRIGHT_TEST_EMAIL=""
PLAYWRIGHT_TEST_PASSWORD=""
PLAYWRIGHT_BASE_URL="http://localhost:3000"
# "1" only against the isolated healthhub_e2e database seeded by scripts/seed-e2e.ts; enables the
# specs that write fixtures. CI requires it.
# PLAYWRIGHT_SEEDED_DB=""

# Set by the tooling, not by you: NODE_ENV and NEXT_RUNTIME (Next.js), CI (CI providers).
