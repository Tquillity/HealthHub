# Copy to .env and fill in values. Never commit .env.

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better-Auth (required)
BETTER_AUTH_SECRET=""          # Generate: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# Client-side auth (optional — only if browser must call auth API on a different origin)
# src/lib/auth-client.ts uses NEXT_PUBLIC_BETTER_AUTH_URL when window is defined
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Journal field encryption (REQUIRED in production — do not rely on fallback)
# If unset in production, journal entries may use BETTER_AUTH_SECRET (weak separation).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=""

# OAuth providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Recipe image upload (optional — Vercel Blob)
BLOB_READ_WRITE_TOKEN=""
USE_LOCAL_STORAGE="true"       # Use local/public/uploads when no blob token

# Database seed (optional — development only)
ADMIN_EMAIL="admin@healthhub.com"
# Leave empty or omit to use default Admin123! on seed/repair. If set, this is your sign-in password.
ADMIN_PASSWORD=""
ADMIN_NAME="Admin User"

# Google AdSense (optional — blocked until legal review; see Docs/AdSense.md)
# NEXT_PUBLIC_ADSENSE_CLIENT=""
# NEXT_PUBLIC_ADSENSE_ENABLED=false

# Stripe (optional — gated premium; see Docs/Stripe.md)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_ID_PRO=""

# Legal gate — set true only after counsel approves Privacy/Terms copy
# LEGAL_REVIEW_APPROVED=false

# Playwright authenticated E2E (optional — see Docs/E2E.md)
# PLAYWRIGHT_TEST_EMAIL=""
# PLAYWRIGHT_TEST_PASSWORD=""
# PLAYWRIGHT_BASE_URL="http://localhost:3000"
