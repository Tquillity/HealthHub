generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  // Note: url is configured in prisma.config.ts for Prisma 7
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  emailVerified       Boolean?
  image               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  role                String    @default("user")
  sessions            Session[]
  accounts            Account[]
  energyLevel         String?
  dietaryRestrictions String[]
  healthGoals         String[]
  timezone            String    @default("UTC")
  enableCycleTracking Boolean   @default(false)
  cycleLength         Int       @default(28)
  lastPeriodDate      DateTime?
  focusPreference     String?
  mealPlanDuration    String?
  mealPlanStartDate   DateTime?
  members             Member[]
  journalEntries      JournalEntry[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id           String    @id
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  password     String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
}

model Organization {
  id                String             @id
  name              String
  slug              String             @unique
  logo              String?
  createdAt         DateTime           @default(now())
  metadata          String?
  members           Member[]
  invitations       Invitation[]
  recipes           Recipe[]
  routines          Routine[]
  mealPlans         MealPlan[]
  shoppingListItems ShoppingListItem[]
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([userId])
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Recipe {
  id             String         @id @default(cuid())
  name           String
  description    String?
  imageUrl       String?
  imageUrls      String[]
  videoUrl       String?
  prepTime       Int?
  cookTime       Int?
  servings       Int?
  category       String?
  difficulty     String?
  cuisine        String?
  calories       Float?
  protein        Float?
  carbs          Float?
  fat            Float?
  fiber          Float?
  sugar          Float?
  sodium         Float?
  tags           String[]
  dietaryTags    String[]
  leanRole       String?
  isSystem       Boolean        @default(false)
  isSecret       Boolean        @default(false)
  isPrivate      Boolean        @default(false)
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  ingredients    Ingredient[]
  instructions   Instruction[]
  mealPlanItems  MealPlanItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Ingredient {
  id       String  @id @default(cuid())
  name     String
  quantity Float
  unit     String
  notes    String?
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Instruction {
  id         String @id @default(cuid())
  stepNumber Int
  text       String
  recipeId   String
  recipe     Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Routine {
  id                String        @id @default(cuid())
  name              String
  description       String?
  imageUrl          String?
  category          String?
  frequency         String?
  energyLevel       String        @default("medium")
  estimatedTime     Int           @default(15)
  context           String?
  duration          String?
  difficulty        String?
  equipment         String[]
  tags              String[]
  steps             Json?
  tips              String[]
  contraindications String[]
  isSystem          Boolean       @default(false)
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model MealPlan {
  id             String         @id @default(cuid())
  organizationId String
  startDate      DateTime
  endDate        DateTime
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          MealPlanItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model MealPlanItem {
  id         String   @id @default(cuid())
  mealPlanId String
  recipeId   String
  date       DateTime
  mealType   String
  servings   Int      @default(4)
  isCooked   Boolean  @default(false)
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe     Recipe   @relation(fields: [recipeId], references: [id])
}

model ShoppingListItem {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  quantity       Float
  unit           String
  category       String?
  isChecked      Boolean      @default(false)
  source         String?
  sourceRecipeId String?
  sourceDate     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model JournalEntry {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime
  mood             Int?
  energy           Int?
  sleepHours       Float?
  notes            String?
  tags             String[]
  gratitudeEntries String[]
  gratitudeNotes   String?
  goalsAchieved    String[]
  goalsProgress    String[]
  goalsNotes       String?
  symptomsPhysical String[]
  symptomsMental   String[]
  symptomsNotes    String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([userId, date])
}

model EducationalResource {
  id          String   @id @default(cuid())
  title       String
  content     String
  excerpt     String?
  category    String
  tags        String[]
  difficulty  String?
  readTime    Int?
  author      String?
  imageUrl    String?
  videoUrl    String?
  externalUrl String?
  featured    Boolean  @default(false)
  viewCount   Int      @default(0)
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Expert {
  id              String                @id @default(cuid())
  name            String
  credentials     String?
  website         String?
  focusAreas      String[]
  recommendations PhaseRecommendation[]
}

model PhaseRecommendation {
  id        String   @id @default(cuid())
  expertId  String
  phase     String
  category  String
  content   Json
  source    String?
  expert    Expert   @relation(fields: [expertId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
