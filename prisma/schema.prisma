generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Note: url is configured in prisma.config.ts for Prisma 7
}

model User {
  id                    String                     @id @default(cuid())
  name                  String
  email                 String                     @unique
  emailVerified         Boolean?
  image                 String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  role                  String                     @default("user")
  sessions              Session[]
  accounts              Account[]
  energyLevel           String?
  dietaryRestrictions   String[]
  healthGoals           String[]
  timezone              String                     @default("UTC")
  enableCycleTracking   Boolean                    @default(false)
  cycleLength           Int                        @default(28)
  lastPeriodDate        DateTime?
  focusPreference       String?
  mealPlanDuration      String?
  mealPlanStartDate     DateTime?
  isPremium             Boolean                    @default(false) @map("is_premium")
  /// Preferred unit for basal body temperature ("C" or "F"). Readings are always stored in Celsius.
  temperatureUnit       String                     @default("C")
  /// Opt-in for resting heart rate, HRV and sleep quality logging and the recovery score.
  trackVitals           Boolean                    @default(false)
  /// Dashboard daily briefing: "daily", "weekly" (Mondays in `timezone`) or "never".
  briefingFrequency     String                     @default("daily")
  /// Data the daily briefing may read: any of "journal", "cycle", "meals", "vitals".
  briefingSources       String[]                   @default(["journal", "cycle", "meals", "vitals"])
  /// Daily briefing detail level: "brief" or "detailed".
  briefingDetail        String                     @default("brief")
  members               Member[]
  journalEntries        JournalEntry[]
  periodStarts          PeriodStart[]
  briefingFeedback      BriefingFeedback[]
  ingredientPreferences UserIngredientPreference[]
  pomoState             PomoState?

  @@map("user")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id           String    @id
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  @@map("verification")
}

model Organization {
  id                String             @id
  name              String
  slug              String             @unique
  logo              String?
  createdAt         DateTime           @default(now())
  metadata          String?
  members           Member[]
  invitations       Invitation[]
  recipes           Recipe[]
  routines          Routine[]
  mealPlans         MealPlan[]
  mealPlanTemplates MealPlanTemplate[]
  shoppingListItems ShoppingListItem[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

model Recipe {
  id                    String                 @id @default(cuid())
  name                  String
  description           String?
  imageUrl              String?
  imageUrls             String[]
  videoUrl              String?
  prepTime              Int?
  cookTime              Int?
  servings              Int?
  category              String?
  difficulty            String?
  cuisine               String?
  calories              Float?
  protein               Float?
  carbs                 Float?
  fat                   Float?
  fiber                 Float?
  sugar                 Float?
  sodium                Float?
  tags                  String[]
  dietaryTags           String[]
  leanRole              String?
  isSystem              Boolean                @default(false)
  isSecret              Boolean                @default(false)
  isPrivate             Boolean                @default(false)
  isHhChefsVerified     Boolean                @default(false)
  organizationId        String?
  organization          Organization?          @relation(fields: [organizationId], references: [id])
  ingredients           Ingredient[]
  instructions          Instruction[]
  mealPlanItems         MealPlanItem[]
  mealPlanTemplateItems MealPlanTemplateItem[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("recipe")
}

model Ingredient {
  id           String                  @id @default(cuid())
  name         String
  quantity     Float
  unit         String
  notes        String?
  recipeId     String
  recipe       Recipe                  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  alternatives IngredientAlternative[]

  @@map("ingredient")
}

model Instruction {
  id         String @id @default(cuid())
  stepNumber Int
  text       String
  recipeId   String
  recipe     Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("instruction")
}

model Routine {
  id                String        @id @default(cuid())
  name              String
  description       String?
  imageUrl          String?
  category          String?
  frequency         String?
  energyLevel       String        @default("medium")
  estimatedTime     Int           @default(15)
  context           String?
  duration          String?
  difficulty        String?
  equipment         String[]
  tags              String[]
  steps             Json?
  tips              String[]
  contraindications String[]
  isSystem          Boolean       @default(false)
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("routine")
}

model MealPlan {
  id             String         @id @default(cuid())
  organizationId String
  startDate      DateTime
  endDate        DateTime
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          MealPlanItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("meal_plan")
}

model MealPlanItem {
  id         String   @id @default(cuid())
  mealPlanId String
  recipeId   String
  date       DateTime
  mealType   String
  servings   Int      @default(4)
  isCooked   Boolean  @default(false)
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe     Recipe   @relation(fields: [recipeId], references: [id])

  @@map("meal_plan_item")
}

model MealPlanTemplate {
  id             String                 @id @default(cuid())
  name           String
  description    String?
  organizationId String
  createdById    String
  isPublic       Boolean                @default(false)
  shareToken     String?                @unique
  items          MealPlanTemplateItem[]
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@map("meal_plan_template")
}

model MealPlanTemplateItem {
  id         String           @id @default(cuid())
  templateId String
  recipeId   String
  dayOffset  Int // Days from start (0 = first day, 1 = second day, etc.)
  mealType   String
  servings   Int              @default(4)
  template   MealPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recipe     Recipe           @relation(fields: [recipeId], references: [id])

  @@map("meal_plan_template_item")
}

model ShoppingListItem {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  quantity       Float
  unit           String
  category       String?
  isChecked      Boolean      @default(false)
  source         String?
  sourceRecipeId String?
  sourceDate     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("shopping_list_item")
}

model JournalEntry {
  id                   String   @id @default(cuid())
  userId               String
  date                 DateTime
  mood                 Int?
  energy               Int?
  sleepHours           Float?
  notes                String?
  tags                 String[]
  gratitudeEntries     String[]
  gratitudeNotes       String?
  goalsAchieved        String[]
  goalsProgress        String[]
  goalsNotes           String?
  symptomsPhysical     String[]
  symptomsMental       String[]
  symptomsNotes        String?
  /// Basal body temperature, stored in Celsius (2 decimals) whatever unit was entered.
  temperature          Float?
  /// Encrypted (lib/encryption): one of dry | sticky | creamy | egg-white | watery.
  cervicalMucus        String?
  /// Resting heart rate in beats per minute.
  restingHeartRate     Int?
  /// Heart rate variability as RMSSD in milliseconds.
  heartRateVariability Float?
  /// Self-rated sleep quality, 1-10.
  sleepQuality         Int?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, date])
  @@map("journal_entry")
}

/// First day of a period. One row per logged start; the latest one is mirrored in
/// User.lastPeriodDate. Used to rebuild past cycles (BBT analysis, cycle lengths).
model PeriodStart {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Date-only, stored as UTC midnight like JournalEntry.date (see lib/date-only).
  date      DateTime
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("period_start")
}

/// What the user did with the dashboard daily briefing, used to personalise later
/// briefings (lib/briefing). One row per action; repeated clicks are de-duplicated in code.
model BriefingFeedback {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Briefing day in the user's timezone. Date-only, stored as UTC midnight like
  /// JournalEntry.date (see lib/date-only).
  date          DateTime
  /// Encrypted (lib/encryption): a suggestion key from lib/briefing, or "briefing" for
  /// the whole card. Keys reveal inferred health state, so they are not stored in clear.
  suggestionKey String
  /// "dismissed" | "helpful" | "not_helpful"
  action        String
  createdAt     DateTime @default(now())

  @@index([userId, date])
  @@map("briefing_feedback")
}

model EducationalResource {
  id          String   @id @default(cuid())
  title       String
  content     String
  excerpt     String?
  /// Structured quick-facts card (TLDR). Shape: LearnTldr in education-schemas.
  tldr        Json?
  category    String
  tags        String[]
  difficulty  String?
  readTime    Int?
  author      String?
  imageUrl    String?
  videoUrl    String?
  externalUrl String?
  featured    Boolean  @default(false)
  viewCount   Int      @default(0)
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("educational_resource")
}

model Expert {
  id              String                @id @default(cuid())
  name            String
  credentials     String?
  website         String?
  focusAreas      String[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  recommendations PhaseRecommendation[]

  @@map("expert")
}

model PhaseRecommendation {
  id        String   @id @default(cuid())
  expertId  String
  phase     String
  category  String
  content   Json
  source    String?
  expert    Expert   @relation(fields: [expertId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("phase_recommendation")
}

model IngredientAlternative {
  id           String     @id @default(cuid())
  ingredientId String
  name         String // The alternative ingredient name
  order        Int        @default(0) // Order in the list (0 = default/first)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([ingredientId])
  @@map("ingredient_alternative")
}

model UserIngredientPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern   String // Normalized pattern to match ingredients (e.g., "smör eller kokosolja")
  preferred String // The preferred alternative name
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, pattern])
  @@index([userId])
  @@map("user_ingredient_preference")
}

/// Premium PomoZen timer state — PostgreSQL source of truth for signed-in Pro users.
model PomoState {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payloadJson Json     @map("payload_json")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("pomo_state")
}

/// Stripe webhook idempotency — one row per processed `event.id`.
model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("stripe_webhook_event")
}
