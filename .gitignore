# Dependencies
node_modules/
/node_modules
.node_modules
/.pnp
.pnp.js
.pnp.loader.mjs

# pnpm local store and metadata (never commit)
.pnpm/
.pnpm-store/
**/.pnpm-store/

# Testing
/coverage
/e2e/.auth/
/test-results/
/playwright-report/

# Next.js – core build output (covers both Webpack and Turbopack)
/.next/
.next
.next/
/out/
/build/

# Turbopack-specific dev-time cache and artifacts (Next.js 15–16+)
/.next/dev/
/.next/cache/
/.next/turbopack/
/.next/*.db
.next/*.log
.next/trace
.next/lock
.next/turbopack.lock

# Turborepo cache and logs
.turbo/
**/.turbo/
*.turbo.log*

# Production builds (some frameworks/Next export)
/dist/

# Misc OS / editor files
.DS_Store
*.pem
Thumbs.db
desktop.ini

# Debug logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
ts-debug.log*

# Local environment variables
.env
.env*.local
.env*.development
.env*.production

# PWA / Workbox generated artifacts (generated at build time)
/public/sw*.js
/public/workbox-*.js
/public/*worker*.js

# Vercel / Netlify / Cloudflare
.vercel
.netlify
.cloudflare

# TypeScript
*.tsbuildinfo
next-env.d.ts

# npm lockfile (project uses pnpm)
package-lock.json

# pnpm-lock.yaml is the only tracked package manager lockfile.
!pnpm-lock.yaml

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Optional: Prisma binary artifacts (if you use Prisma)
prisma/dev.db
prisma/*.db

# Optional: Any local SQLite databases
*.db
*.sqlite
*.sqlite3

# MCP
mcp.json